# ==============================================================================
# ORBIT — Monorepo Git Ignore Rules
# ==============================================================================

# Operating System & File System Artifacts
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
.DS_Store
.AppleDouble
.LSOverride

# Environment Variables & Secret Configuration Files
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Python & Backend Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Database Files, Runtime Storage & Backups
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
backups/
*.bak
*.bak-shm
*.bak-wal
orbit.db
backend/orbit.db

# Node.js & Frontend Artifacts
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js

# Testing & Coverage
coverage/
frontend/coverage/

# IDE & Editor Artifacts
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Temporary & Log Files
*.log
logs/
tmp/
temp/
scratch/
