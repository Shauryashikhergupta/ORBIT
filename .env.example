# ==============================================================================
# ORBIT (Operational Risk & Business Intelligence Terminal)
# Environment Variables Configuration Template - Phase 4 Production Standard
# ==============================================================================

# ------------------------------------------------------------------------------
# Security & Authentication Controls (Phase 4 Hardening)
# ------------------------------------------------------------------------------
# Enforcement: In production, ORBIT_AUTH_ENFORCE must be True.
ORBIT_ENVIRONMENT=production
ORBIT_AUTH_ENFORCE=True
ORBIT_DEBUG=False

# Bootstrap admin token for initializing the first administrator account:
# Used once via POST /api/auth/init-admin or manage.py CLI
ORBIT_INITIAL_ADMIN_TOKEN=orbit-admin-initial-secret-change-me

# Session Management:
# Session lifetime in hours (24h default). Sessions are cryptographically random 256-bit tokens.
ORBIT_SESSION_TTL_HOURS=24

# Brute-force protection:
# 5 failed login attempts per username/IP within 15 minutes triggers automatic temporary lockout.
ORBIT_MAX_LOGIN_ATTEMPTS=5
ORBIT_LOCKOUT_MINUTES=15

# API Request Limiter:
# Maximum allowed payload size in bytes (10MB default) to prevent memory exhaustion / DoS.
ORBIT_MAX_UPLOAD_BYTES=10485760

# ------------------------------------------------------------------------------
# Database Persistence & Reliability
# ------------------------------------------------------------------------------
# Primary SQLite storage path (uses WAL mode for concurrency and zero-downtime backups):
SQLITE_DB_PATH=./orbit.db
BACKUP_DIR=./backups

# Standard Database URI (SQLite default or PostgreSQL with PostGIS):
# SQLite: sqlite:///./orbit.db
# PostgreSQL + PostGIS: postgresql+psycopg2://orbit_user:secure_password@localhost:5432/orbit_db
DATABASE_URL=sqlite:///./orbit.db
USE_PERSISTENCE=True

# ------------------------------------------------------------------------------
# Geospatial Routing & Upstream Services
# ------------------------------------------------------------------------------
# OSRM (Open Source Routing Machine) backend:
# Default uses public demo server; deploy dedicated OSRM instance for high-throughput enterprise use.
ORBIT_ROUTING_OSRM_URL=https://router.project-osrm.org
ORBIT_ROUTING_TIMEOUT_SECONDS=10.0

# Upstream Public Data Feeds Toggle:
ENABLE_USGS=True
ENABLE_NASA_EONET=True
ENABLE_EMSC=True
ENABLE_GDELT=True
ENABLE_ACLED=False

# Ingestion Pipeline & Synchronization (seconds)
SYNC_INTERVAL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=12.0

# ------------------------------------------------------------------------------
# Frontend Configuration (Next.js 14)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="ORBIT - Operational Risk & Business Intelligence Terminal"
NEXT_PUBLIC_VERSION="1.0.0-phase4"
